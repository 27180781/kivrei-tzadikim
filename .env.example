# Postgres (ב-CapRover: אפליקציית One-Click בשם kivrei-db)
# בתוך CapRover הכתובת הפנימית היא srv-captain--<שם אפליקציית ה-DB>
DATABASE_URL=postgres://postgres:PASSWORD@srv-captain--kivrei-db:5432/postgres
# סיסמת הכניסה לממשק הניהול (/admin)
ADMIN_PASSWORD=

# התראות במייל (Mailer API של mail.retsef.co.il). בלי המפתח לא יישלחו מיילים.
MAILER_API_KEY=
# כתובת שולח בדומיין מאומת במערכת המיילים
MAIL_FROM=
MAIL_FROM_NAME=קברי צדיקים
# כתובת האתר, לקישורים שבמייל
SITE_URL=https://kivrei-tzadikim.caprover.clicker.co.il
# שעת שליחת המייל היומי, שעון ישראל (ברירת מחדל 12)
EMAIL_DAILY_HOUR=12
